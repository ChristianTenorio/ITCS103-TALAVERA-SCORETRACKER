import openpyxl
from openpyxl.utils import get_column_letter

def get_student_data():
    student_data = []
    while True:
        name = input("Enter student name (or type 'done' to finish): ")
        if name.lower() == 'done':
            break
        while True:
            try:
                score = int(input(f"Enter {name}'s score: "))
                if 0 <= score <= 100:
                    break
                else:
                    print("Score must be between 0 and 100.")
            except ValueError:
                print("Invalid input. Please enter a valid number for the score.")
        student_data.append({'name': name, 'score': score})
    return student_data

def update_excel_sheet(filename="student_scores.xlsx", data=None):
    if data is None or not data:
        try:
            workbook = openpyxl.load_workbook(filename)
        except FileNotFoundError:
            workbook = openpyxl.Workbook()
        sheet = workbook.active
        sheet.title = "Student Scores"
        sheet.append(["Name", "Score", "Status"])
        workbook.save(filename)
        print(f"Created new Excel file: {filename} with headers, no data added.")
        return

    try:
        workbook = openpyxl.load_workbook(filename)
        sheet = workbook.active
    except FileNotFoundError:
        workbook = openpyxl.Workbook()
        sheet = workbook.active
        sheet.title = "Student Scores"

    if sheet.max_row == 0:
        sheet.append(["Name", "Score", "Status"])
    elif sheet.cell(row=1, column=1).value != "Name":
        sheet.append(["Name", "Score", "Status"])

    for student in data:
        name = student['name']
        score = student['score']
        status = "Pass" if score >= 60 else "Fail"
        sheet.append([name, score, status])

    workbook.save(filename)
    print(f"Data successfully written to {filename}")

def retrieve_and_display_records(filename="student_scores.xlsx"):
    try:
        workbook = openpyxl.load_workbook(filename)
        sheet = workbook.active
    except FileNotFoundError:
        print(f"Error: The file '{filename}' was not found.")
        return
    except openpyxl.utils.exceptions.InvalidFileException:
        print(f"Error: The file '{filename}' is not a valid Excel file.")
        return

    if sheet.max_row == 0:
        print("The sheet is empty; no records to display.")
        return

    for col_num in range(1, sheet.max_column + 1):
        col_letter = get_column_letter(col_num)
        cell_value = sheet[f"{col_letter}1"].value
        print(f"{cell_value:10}", end=" ")
    print()

    for row_index in range(2, sheet.max_row + 1):
        row_data = []
        for col_index in range(1, sheet.max_column + 1):
            cell_value = sheet.cell(row=row_index, column=col_index).value
            row_data.append(str(cell_value))
        print(f"{row_data[0]:10} {row_data[1]:10} {row_data[2]:10}")

def main():
    print("Welcome to the Student Score Tracker!")
    student_data = get_student_data()
    update_excel_sheet(data=student_data)
    print("\nAll records:")
    retrieve_and_display_records()

if __name__ == "__main__":
    main()
